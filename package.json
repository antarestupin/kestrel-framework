{
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "name": "kestrel-workspace",
  "workspaces": [
    "src/packages/*",
    "src/apps/*"
  ],
  "scripts": {
    "build:ai": "npm run build:ai --workspace=@kestrel/framework && npm run build:ai --workspace=@kestrel/playground",
    "docs:dev": "npm run dev --workspace=@kestrel/docs",
    "docs:build": "npm run build:ai --workspace=@kestrel/docs",
    "docs:preview": "npm run preview --workspace=@kestrel/docs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:ai": "vitest run --reporter=minimal --no-isolate",
    "test:unit": "vitest run --reporter=minimal --no-isolate --project=unit",
    "test:integration": "vitest run --reporter=minimal --no-isolate --project=integration",
    "infra:up": "docker compose -f infrastructure/compose.yml up -d --wait",
    "infra:down": "docker compose -f infrastructure/compose.yml stop",
    "infra:prepare": "node infrastructure/prepare.mjs",
    "pack:local": "npm run build:ai && mkdir -p artifacts && npm pack --workspace=@kestrel/framework --pack-destination=artifacts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:playground": "node scripts/check-playground.mjs",
    "verify:archive": "node scripts/verify-archive.mjs"
  },
  "devDependencies": {
    "@docusaurus/core": "3.10.2",
    "@redis/client": "^6.2.1",
    "@tanstack/router-plugin": "^1.168.33",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "pg": "^8.22.0"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "serialize-javascript": "7.1.2",
    "sockjs": {
      "uuid": "11.1.1"
    }
  }
}
