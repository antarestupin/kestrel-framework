{
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "name": "kestrel-workspace",
  "workspaces": [
    "src/packages/*",
    "src/apps/*"
  ],
  "scripts": {
    "build:ai": "npm run build:ai --workspace=@kestreljs/framework && npm run build:ai --workspace=@kestrel/playground",
    "docs:dev": "npm run dev --workspace=@kestrel/docs",
    "docs:build": "npm run build:ai --workspace=@kestrel/docs",
    "docs:preview": "npm run preview --workspace=@kestrel/docs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --reporter=minimal --no-isolate --project=unit --project=integration",
    "test:ai": "vitest run --reporter=minimal --no-isolate --project=unit --project=integration",
    "test:mutation": "node scripts/testing/mutation.mjs",
    "test:mutation:fast": "node scripts/testing/mutation.mjs --mode fast",
    "test:mutation:component": "node scripts/testing/mutation.mjs --mode component",
    "test:mutation:static-sample": "node scripts/testing/mutation.mjs --mode static-sample",
    "test:mutation:shutdown": "node scripts/testing/mutation.mjs --mode shutdown",
    "test:mutation:authentication-sessions": "node scripts/testing/mutation.mjs --mode authentication-sessions",
    "test:mutation:authorization-decisions": "node scripts/testing/mutation.mjs --mode authorization-decisions",
    "test:mutation:password-verification": "node scripts/testing/mutation.mjs --mode password-verification",
    "test:mutation:postgres-ownership": "node scripts/testing/mutation.mjs --mode postgres-ownership",
    "test:mutation:throttling-inspection": "node scripts/testing/mutation.mjs --mode throttling-inspection",
    "test:mutation:lock-renewal": "node scripts/testing/mutation.mjs --mode lock-renewal",
    "test:mutation:dry-run": "node scripts/testing/mutation.mjs --dryRunOnly",
    "test:mutation:infrastructure": "node --test scripts/testing/*.test.mjs",
    "check:mutation-inventory": "node scripts/testing/check-mutation-inventory.mjs",
    "test:generator": "vitest run --reporter=minimal --no-isolate --project=generator",
    "test:all": "vitest run --reporter=minimal --no-isolate",
    "test:unit": "vitest run --reporter=minimal --no-isolate --project=unit",
    "test:integration": "vitest run --reporter=minimal --no-isolate --project=integration",
    "infra:up": "docker compose -f infrastructure/compose.yml up -d --wait",
    "infra:down": "docker compose -f infrastructure/compose.yml stop",
    "infra:prepare": "node infrastructure/prepare.mjs",
    "pack:local": "npm run build:ai && node scripts/release.mjs pack artifacts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:playground": "node scripts/check-playground.mjs",
    "verify:archive": "node scripts/verify-archive.mjs",
    "pack:dry-run": "npm run build:ai && npm pack --dry-run --workspace=./src/packages/kestrel --workspace=./src/packages/create-kestrel",
    "publish:kestrel": "node scripts/release.mjs publish artifacts/candidate framework",
    "publish:create-kestrel": "node scripts/release.mjs publish artifacts/candidate creator",
    "publish:next": "node scripts/release.mjs publish artifacts/candidate all",
    "test:release": "node --test scripts/release/*.test.mjs",
    "check:security": "node scripts/release/security.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:consumer": "node scripts/release.mjs consumer",
    "release:docs": "node scripts/release.mjs docs",
    "release:finalize": "node scripts/release.mjs finalize",
    "release:validate": "node scripts/release.mjs validate",
    "release:verify": "node scripts/release.mjs verify",
    "test:mutation:actions-crud-pagination": "node scripts/testing/mutation.mjs --mode actions-crud-pagination",
    "test:mutation:cache-pruning": "node scripts/testing/mutation.mjs --mode cache-pruning",
    "test:mutation:execution-diagnostics": "node scripts/testing/mutation.mjs --mode execution-diagnostics",
    "test:mutation:catalog-identities": "node scripts/testing/mutation.mjs --mode catalog-identities",
    "test:mutation:atlas-collection-query": "node scripts/testing/mutation.mjs --mode atlas-collection-query",
    "test:mutation:scheduled-runtime": "node scripts/testing/mutation.mjs --mode scheduled-runtime",
    "test:mutation:scheduled-adapters": "node scripts/testing/mutation.mjs --mode scheduled-adapters",
    "test:mutation:scheduled-contracts": "node scripts/testing/mutation.mjs --mode scheduled-contracts",
    "test:mutation:workers-publication": "node scripts/testing/mutation.mjs --mode workers-publication",
    "test:mutation:workers-adapters": "node scripts/testing/mutation.mjs --mode workers-adapters",
    "test:mutation:outbound-resilience": "node scripts/testing/mutation.mjs --mode outbound-resilience",
    "test:mutation:workflow-task-ownership": "node scripts/testing/mutation.mjs --mode workflow-task-ownership",
    "test:mutation:workflow-execution-retry": "node scripts/testing/mutation.mjs --mode workflow-execution-retry",
    "test:mutation:workers-delivery": "node scripts/testing/mutation.mjs --mode workers-delivery",
    "test:mutation:workflow-terminal-control": "node scripts/testing/mutation.mjs --mode workflow-terminal-control",
    "test:mutation:workers-contracts": "node scripts/testing/mutation.mjs --mode workers-contracts"
  },
  "devDependencies": {
    "@docusaurus/core": "3.10.2",
    "@redis/client": "^6.2.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tanstack/router-plugin": "^1.168.33",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "pg": "^8.22.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "serialize-javascript": "7.1.2",
    "sockjs": {
      "uuid": "11.1.1"
    },
    "tinypool": "2.1.2",
    "minimatch@>=10": {
      "brace-expansion": "5.0.12"
    }
  },
  "packageManager": "npm@11.9.0"
}
