// Configures the editor devcontainer, forwarded ports, and setup commands.
// Keep its service and workspace settings aligned with docker-compose.yml.

{
  "name": "Kestrel Playground",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace/kestrel-playground",
  "remoteUser": "node",
  "shutdownAction": "stopCompose",
  "forwardPorts": [
    3333
  ],
  "postCreateCommand": "npm install",
  "postStartCommand": "bash .devcontainer/ensure-test-database.sh",
  "remoteEnv": {
    "TZ": "UTC"
  }
}
