{
  "name": "@kestrel/playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "KESTREL_WATCH=1 ./do run server",
    "start": "ENVIRONMENT=prod NODE_ENV=production KESTREL_COMPILED=1 ./do run server",
    "api:generate": "./do generate http-clients",
    "build:ai": "npm run api:generate && tsc -p tsconfig.build.json && node scripts/copy-database-assets.mjs && vite build --config src/client/vite.config.ts --logLevel error",
    "typecheck": "tsc --noEmit",
    "test:ai": "ENVIRONMENT=test vitest run --reporter=minimal --no-isolate",
    "db:generate": "tsx src/server/core/db/generate_migration.ts",
    "db:migrate": "./do database migrate",
    "cli": "./do",
    "db:check": "drizzle-kit check",
    "db:dev:migrate": "./do database migrate && drizzle-kit push --config=drizzle.dev-push.config.ts && tsx src/server/core/db/apply_development_schema_contributions.ts",
    "dev:database": "drizzle-kit studio --config=drizzle.dev.config.ts --host=127.0.0.1 --port=4983",
    "test": "ENVIRONMENT=test vitest run --no-isolate",
    "test:watch": "ENVIRONMENT=test vitest",
    "infra:up": "docker compose -f .devcontainer/docker-compose.yml up -d --wait postgres",
    "infra:down": "docker compose -f .devcontainer/docker-compose.yml stop"
  },
  "dependencies": {
    "@kestrel/framework": "0.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "@fastify/vite": "^10.0.0"
  },
  "license": "UNLICENSED"
}
