// Native-client lifecycle stays in the application provider, without a Redis server.
import { expect, it, vi } from "vitest";
import { App } from "@kestreljs/framework/app";
import { dep } from "@kestreljs/framework/di";
import { RedisProvider, redisDependency, type RedisClient } from "./redis_provider.js";

function setup() {
  const clients: ReturnType<typeof makeClient>[] = [];
  function makeClient() {
    const client = {
      isOpen: false,
      connect: vi.fn(async () => { client.isOpen = true; }),
      sendCommand: vi.fn(async () => "OK"),
      eval: vi.fn(async () => null),
      destroy: vi.fn(() => { client.isOpen = false; }),
    };
    return client;
  }
  class TestRedisProvider extends RedisProvider<object> {
    protected createClient(): RedisClient {
      const client = makeClient();
      clients.push(client);
      return client as unknown as RedisClient;
    }
  }
  return { clients, TestRedisProvider };
}
const config = { url: "redis://localhost:6379/2", connectTimeoutMs: 100 };

it("shares the native client, connects during standard boot and closes it once", async () => {
  const { clients, TestRedisProvider } = setup();
  const app = new App({}).register(new TestRedisProvider(config));
  try {
    expect(clients).toHaveLength(0);
    await app.start();
    const client = app.container.resolve(redisDependency);
    expect(client).toBe(clients[0]);
    expect(app.container.resolve(redisDependency)).toBe(client);
    expect(clients[0]!.connect).toHaveBeenCalledOnce();
    await client.eval("return 1", { keys: [], arguments: [] });
    expect(clients[0]!.eval).toHaveBeenCalledOnce();
  } finally { await app.dispose(); }
  expect(clients[0]!.destroy).toHaveBeenCalledOnce();
});

it("disposes unused registrations without creating clients", async () => {
  const { clients, TestRedisProvider } = setup();
  const app = new App({}).register(new TestRedisProvider(config));
  await app.dispose();
  expect(clients).toHaveLength(0);
});

it("leaves Redis unresolved during minimal boot", async () => {
  const { clients, TestRedisProvider } = setup();
  const app = new App({}).register(new TestRedisProvider(config));
  app.prepareBootPlan([], "minimal");
  try {
    await app.start();
    expect(clients).toHaveLength(0);
  } finally { await app.dispose(); }
});

it("owns dedicated connections independently", async () => {
  const { clients, TestRedisProvider } = setup();
  const dedicated = dep<RedisClient>("securityRedis");
  const app = new App({})
    .register(new TestRedisProvider(config))
    .register(new TestRedisProvider(config, dedicated));
  try {
    await app.start();
    expect(app.container.resolve(redisDependency)).not.toBe(app.container.resolve(dedicated));
    expect(clients).toHaveLength(2);
    for (const client of clients) expect(client.connect).toHaveBeenCalledOnce();
  } finally { await app.dispose(); }
  for (const client of clients) expect(client.destroy).toHaveBeenCalledOnce();
});

it("propagates boot failures and still disposes the owned client", async () => {
  const { clients, TestRedisProvider } = setup();
  const app = new App({}).register(new TestRedisProvider(config));
  app.container.resolve(redisDependency);
  clients[0]!.connect.mockImplementationOnce(async () => {
    clients[0]!.isOpen = true;
    throw new Error("Redis unavailable");
  });
  try { await expect(app.start()).rejects.toThrow("Redis unavailable"); }
  finally { await app.dispose(); }
  expect(clients[0]!.destroy).toHaveBeenCalledOnce();
});
