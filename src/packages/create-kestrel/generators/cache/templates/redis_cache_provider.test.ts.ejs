// Verify that cache composition borrows the selected connection without taking ownership.
import { expect, it, vi } from "vitest";
import { App } from "@kestreljs/framework/app";
import { cacheDependency } from "@kestreljs/framework/cache";
import { LoggerProvider } from "@kestreljs/framework/log";
import { appConfig } from "../appConfig.js";
import { dep } from "@kestreljs/framework/di";
import { RedisCacheProvider } from "./redis_cache_provider.js";
import { redisDependency, type RedisClient } from "./redis_provider.js";

it.each([false, true])("borrows the selected Redis connection (custom=%s)", async (custom) => {
  const app = new App(appConfig).register(new LoggerProvider(appConfig.logger));
  const shared = { sendCommand: vi.fn(async () => null) };
  const dedicated = { sendCommand: vi.fn(async () => null) };
  const dedicatedDependency = dep<RedisClient>("cacheRedis");
  app.container.registerValue(redisDependency.id, shared);
  app.container.registerValue(dedicatedDependency.id, dedicated);
  app.register(new RedisCacheProvider(appConfig.cache, custom ? dedicatedDependency : undefined));
  try {
    const cache = app.container.resolve(cacheDependency);
    await cache.get("example");
    expect((custom ? dedicated : shared).sendCommand).toHaveBeenCalledOnce();
    expect((custom ? shared : dedicated).sendCommand).not.toHaveBeenCalled();
    // Cache composition must not require a database or register a private Redis connection.
    expect(app.container.hasRegistration("database")).toBe(false);
    expect(app.container.hasRegistration("redisCacheConnection")).toBe(false);
  } finally { await app.dispose(); }
});
