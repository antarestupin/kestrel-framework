# Documents local environment overrides for HTTP, logging, and database connections.
# Copy this file to .env and adjust values for your machine; keep secrets out of version control.

# Local HTTP server settings.
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info
# Schema-backed HTTP settings also support conventional overrides.
APP_CONFIG__HTTP__EXECUTION_ID_HEADER=x-execution-id

# Local PostgreSQL settings; the test database is selected in the test environment.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=kestrel_playground
DB_TEST_DATABASE=kestrel_playground_test
DB_SSL=false
