# Install the generated application's tooling independently of host dependencies.
# The optional vendor directory supports local archives as well as registry dependencies.
FROM node:24-bookworm

WORKDIR /workspace/__KESTREL_APPLICATION_NAME__
COPY package*.json ./
COPY vendor/ ./vendor/

# Honor the application lockfile when present and never execute dependency lifecycle scripts.
RUN if [ -f package-lock.json ]; then \
      npm ci --ignore-scripts --no-audit --no-fund; \
    else \
      npm install --ignore-scripts --no-audit --no-fund; \
    fi

USER node
