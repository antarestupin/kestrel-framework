# Local HTTP server settings.
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info

# Local PostgreSQL settings; the test database is selected in the test environment.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=kestrel_playground
DB_TEST_DATABASE=kestrel_playground_test
DB_SSL=false

# Available to optional application-owned Redis adapters.
REDIS_URL=redis://127.0.0.1:56379/0
