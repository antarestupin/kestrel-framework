{
  "name": "@kestrel/playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch --import zod/compile src/server/main.ts",
    "start": "node --import zod/compile dist/server/main.js",
    "api:generate": "node --import tsx --import zod/compile src/server/generate.ts",
    "build:ai": "npm run api:generate && tsc -p tsconfig.build.json && vite build --logLevel error",
    "typecheck": "tsc --noEmit",
    "test:ai": "vitest run --reporter=minimal --no-isolate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx src/server/core/db/migrate.ts"
  },
  "dependencies": {
    "@kestrel/framework": "0.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "pg": "^8.22.0",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.5.4",
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "@fastify/vite": "^10.0.0"
  },
  "license": "UNLICENSED"
}
